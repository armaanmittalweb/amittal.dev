{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  // api.amittal.dev is the public API; admin.amittal.dev is the dashboard (custom domains:
  // Cloudflare creates the DNS records and certificates).
  "routes": [
    { "pattern": "api.amittal.dev", "custom_domain": true },
    { "pattern": "admin.amittal.dev", "custom_domain": true }
  ],
  // The dashboard's files. The Worker runs first on every request, so api.amittal.dev never serves them.
  "assets": { "directory": "./admin-ui/dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "build": { "command": "npm run build:ui" },
  "vars": {
    // Checked services when the admin has not changed the list (settings.live in D1).
    "LIVE": "archive,edusched,safespace,openingos,farmsaathi,loomcore",
    "ADMIN_HOST": "admin.amittal.dev",
    "CF_ACCOUNT_ID": "97aa1d30eb49a5168de748e049a18f5d",
    "NEON_PROJECTS": "edusched:solitary-river-84073411,openingos:autumn-dust-23522001",
    "VERCEL_TEAM_ID": "team_SH0KbKBooKdzfxZQtQJNnLyk"
  },
  // Secrets (wrangler secret put): ADMIN_PASSWORD_HASH, SESSION_SECRET, INTERNAL_KEY, and optionally
  // CF_API_TOKEN, NEON_API_KEY, VERCEL_TOKEN, NTFY_TOPIC. See README.
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard", "database_id": "a0add2ce-78e3-4f86-a548-6785d6e388ab" }],
  // The project Workers, reached without leaving Cloudflare (health checks, /edusched/*, admin stats).
  "services": [
    { "binding": "EDUSCHED", "service": "edusched-api" },
    { "binding": "OPENINGOS", "service": "openingos-sync" },
    { "binding": "SAFESPACE", "service": "safespace-api" },
    { "binding": "FARMSAATHI", "service": "farmsaathi-api" }
  ],
  "ratelimits": [
    { "name": "HIT_LIMITER", "namespace_id": "4201", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "4202", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
