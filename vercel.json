{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/resume{/}?",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Armaan_Mittal_Resume.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/resume/general.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Armaan_Mittal_Resume.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/resume/backend.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Armaan_Mittal_Resume_Backend.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/resume/ai-ml.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Armaan_Mittal_Resume_AI_ML.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/resume/full-stack.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Armaan_Mittal_Resume_Full_Stack.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/resume/general.pdf"
    },
    {
      "source": "/resume/",
      "destination": "/resume/general.pdf"
    }
  ]
}
